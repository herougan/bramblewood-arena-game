    echo "| $p | ${line:-no result (skipped, cancelled, timed out or crashed)} | ${fails} |"
  done
  all=$(cat res/*/failures.txt 2>/dev/null | sort -u)
  echo
  if [ -n "$all" ]; then echo "**Failed ($(echo "$all" | wc -l)):** $(echo "$all" | paste -sd, | sed 's/,/, /g')"; else echo "**No failing test reported.**"; fi
