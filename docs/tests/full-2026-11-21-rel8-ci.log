  echo "## Tests (${GITHUB_REF_NAME} @ ${GITHUB_SHA::7})"
  echo "| part | result | failed |"
  echo "|---|---|---|"
  for p in smoke $(seq -f 'shard-%g' 1 "$SHARDS"); do
    d=res/tests-$p
    line=$(grep -E '^(smoke|tests): ' "$d/ci.log" 2>/dev/null | tail -1 | sed 's/ (passed before.*//; s/ ·.*//' || true)
