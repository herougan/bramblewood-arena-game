{
  "name": "bramblewood-arena-desktop",
  "productName": "Bramblewood Arena",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop wrapper (proof of concept, 2026-10-17) that runs the built index.html from local files. See docs/platform-roadmap-2026-10-17.md.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "stage": "node stage.js",
    "start:staged": "node stage.js && electron . --root=game",
    "dist": "node stage.js && electron-builder --dir",
    "icon": "python3 -I build/make_icon.py"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.bramblewood.arena",
    "productName": "Bramblewood Arena",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "steam.js", "package.json", "build/icon.png"],
    "extraResources": [{ "from": "game", "to": "game" }],
    "asar": true,
    "asarUnpack": ["node_modules/steamworks.js/**"],
    "icon": "build/icon.png",
    "win": { "target": ["dir"], "icon": "build/icon.ico" },
    "mac": { "target": ["dir"], "category": "public.app-category.games", "icon": "build/icon.png" },
    "linux": { "target": ["dir"], "category": "Game", "icon": "build/icons" }
  }
}
